# Set ONE of these LLM keys (required)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional — higher-quality web search (falls back to free DuckDuckGo if unset)
TAVILY_API_KEY=

# Optional — enables email notifications when a report finishes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated list of allowed origins for CORS in production.
# Leave unset in local dev to allow all origins.
# Example: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=
